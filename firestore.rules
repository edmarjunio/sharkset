rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if false;
    }
    match /athlete_contacts/{athleteId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isVerifiedUser() &&
        get(/databases/$(database)/documents/athletes_public/$(athleteId)).data.ownerId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['ownerId', 'phone', 'whatsappOptIn']) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{10,15}$') &&
        request.resource.data.whatsappOptIn is bool;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidArena(data) {
      return data.keys().hasAll(['id', 'name', 'city', 'state', 'ownerId']) &&
        data.keys().hasOnly(['id', 'name', 'city', 'state', 'distanceKm', 'rating', 'whatsapp', 'ownerId']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        data.state is string && data.state.size() >= 1 && data.state.size() <= 10 &&
        data.ownerId is string && data.ownerId == request.auth.uid;
    }

    function isValidAthletePublic(data) {
      return data.keys().hasAll(['id', 'name', 'level', 'points', 'country', 'state', 'city', 'arenaId', 'ownerId']) &&
        data.keys().hasOnly([
          'id', 'name', 'level', 'experienceCategory', 'points', 'wins',
          'matchesPlayed', 'titlesCount', 'country', 'state', 'city',
          'arenaId', 'arenaName', 'ownerId', 'lastMatchAt', 'rankingInactive',
          'highestHistoricalLevel', 'levelMatches', 'levelWins', 'levelPoints'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.level is string && data.level in ['iniciante', 'serie_c', 'serie_b', 'serie_a', 'profissional'] &&
        data.points is number && data.points >= 0 &&
        data.country is string && data.country.size() >= 1 && data.country.size() <= 60 &&
        data.state is string && data.state.size() >= 1 && data.state.size() <= 10 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        data.arenaId is string && data.arenaId.size() >= 1 && data.arenaId.size() <= 64 &&
        data.ownerId is string && data.ownerId == request.auth.uid;
    }

    function isValidBookingRecord(data) {
      return data.keys().hasAll(['id', 'tenantId', 'courtId', 'date', 'startTime', 'status', 'ownerId']) &&
        data.keys().hasOnly([
          'id', 'tenantId', 'courtId', 'courtName', 'date', 'startTime',
          'endTime', 'sport', 'customerName', 'price', 'status', 'ownerId'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.tenantId is string && data.tenantId.size() >= 1 && data.tenantId.size() <= 64 &&
        data.courtId is string && data.courtId.size() >= 1 && data.courtId.size() <= 64 &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 20 &&
        data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 10 &&
        data.status is string && data.status in ['confirmed', 'cancelled'] &&
        data.ownerId is string && data.ownerId == request.auth.uid;
    }

    function isValidSmartNotification(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'body', 'ownerId']) &&
        data.keys().hasOnly(['id', 'type', 'title', 'body', 'recipientName', 'ownerId']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.type is string && data.type in [
          'vacant_2h', 'waitlist_freed', 'match_10pts_left', 'booking_15min',
          'match_starting', 'match_modified', 'tuition_due_today', 'tuition_due_2days'
        ] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 400 &&
        data.ownerId is string && data.ownerId == request.auth.uid;
    }

    function isValidMatchMvpVote(data) {
      return data.keys().hasAll(['id', 'matchId', 'tournamentId', 'playerName', 'pairNames', 'voterName', 'votedAt', 'ownerId']) &&
        data.keys().hasOnly([
          'id', 'matchId', 'tournamentId', 'tournamentName', 'playerName',
          'pairNames', 'voterName', 'votedAt', 'ownerId'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.matchId is string && data.matchId.size() >= 1 && data.matchId.size() <= 64 &&
        data.tournamentId is string && data.tournamentId.size() >= 1 && data.tournamentId.size() <= 64 &&
        data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 120 &&
        data.pairNames is string && data.pairNames.size() >= 1 && data.pairNames.size() <= 160 &&
        data.voterName is string && data.voterName.size() >= 1 && data.voterName.size() <= 120 &&
        data.votedAt is string && data.votedAt.size() >= 1 && data.votedAt.size() <= 40 &&
        data.ownerId is string && data.ownerId == request.auth.uid;
    }

    function isValidAcademyPost(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'mediaType', 'summary', 'authorName', 'level', 'likesCount', 'ownerId']) &&
        data.keys().hasOnly([
          'id', 'title', 'category', 'mediaType', 'mediaUrl', 'summary',
          'authorName', 'level', 'likesCount', 'ownerId'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.category is string && data.category in [
          'marcacao_padrao', 'posicionamento_quadra', 'corrida_areia', 'base_defesa', 'ataque_shark', 'comunidade'
        ] &&
        data.mediaType is string && data.mediaType in ['video', 'document', 'image'] &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 600 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.level is string && data.level in ['iniciante', 'intermediario', 'avancado', 'todos'] &&
        data.likesCount is number && data.likesCount >= 0 &&
        data.ownerId is string && data.ownerId == request.auth.uid;
    }

    match /arenas/{arenaId} {
      allow get: if isValidId(arenaId) && isOwner(existing().ownerId);
      allow list: if isOwner(existing().ownerId);
      allow create: if isVerifiedUser() && isValidId(arenaId) && isValidArena(incoming());
      allow update: if isVerifiedUser() && isValidId(arenaId) && isValidArena(incoming()) &&
        isOwner(existing().ownerId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'distanceKm', 'rating', 'whatsapp']);
      allow delete: if isVerifiedUser() && isValidId(arenaId) && isOwner(existing().ownerId);
    }

    match /athletes_public/{athleteId} {
      allow get: if isValidId(athleteId) && isOwner(existing().ownerId);
      allow list: if isOwner(existing().ownerId);
      allow create: if isVerifiedUser() && isValidId(athleteId) && isValidAthletePublic(incoming());
      allow update: if isVerifiedUser() && isValidId(athleteId) && isValidAthletePublic(incoming()) &&
        isOwner(existing().ownerId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'level', 'experienceCategory', 'points', 'wins', 'matchesPlayed',
          'titlesCount', 'country', 'state', 'city', 'arenaId', 'arenaName'
        ]);
      allow delete: if isVerifiedUser() && isValidId(athleteId) && isOwner(existing().ownerId);
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isOwner(existing().ownerId);
      allow list: if isOwner(existing().ownerId);
      allow create: if isVerifiedUser() && isValidId(bookingId) && isValidBookingRecord(incoming());
      allow update: if isVerifiedUser() && isValidId(bookingId) && isValidBookingRecord(incoming()) &&
        isOwner(existing().ownerId) &&
        existing().status != 'cancelled' &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isVerifiedUser() && isValidId(bookingId) && isOwner(existing().ownerId);
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isOwner(existing().ownerId);
      allow list: if isOwner(existing().ownerId);
      allow create: if isVerifiedUser() && isValidId(notificationId) && isValidSmartNotification(incoming());
      allow update: if isVerifiedUser() && isValidId(notificationId) && isValidSmartNotification(incoming()) &&
        isOwner(existing().ownerId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body']);
      allow delete: if isVerifiedUser() && isValidId(notificationId) && isOwner(existing().ownerId);
    }

    match /match_mvp_votes/{voteId} {
      allow get: if isValidId(voteId) && isOwner(existing().ownerId);
      allow list: if isOwner(existing().ownerId);
      allow create: if isVerifiedUser() && isValidId(voteId) && isValidMatchMvpVote(incoming());
      allow update: if isVerifiedUser() && isValidId(voteId) && isValidMatchMvpVote(incoming()) &&
        isOwner(existing().ownerId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['playerName', 'pairNames', 'votedAt']);
      allow delete: if isVerifiedUser() && isValidId(voteId) && isOwner(existing().ownerId);
    }

    match /academy_posts/{postId} {
      allow get: if isValidId(postId) && isOwner(existing().ownerId);
      allow list: if isOwner(existing().ownerId);
      allow create: if isVerifiedUser() && isValidId(postId) && isValidAcademyPost(incoming());
      allow update: if isVerifiedUser() && isValidId(postId) && isValidAcademyPost(incoming()) &&
        isOwner(existing().ownerId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'likesCount']);
      allow delete: if isVerifiedUser() && isValidId(postId) && isOwner(existing().ownerId);
    }
  }
}
