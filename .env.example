FIRESTORE_DATABASE_ID=
# Explicit local preview only. Keep false for real availability; preview never creates bookings.
VITE_BOOKING_DEMO=false
INACTIVITY_JOB_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_INACTIVITY_TEMPLATE=
WHATSAPP_PHONE_NUMBER_ID=

# Public configuration only. Never put LIVEKIT_API_KEY, LIVEKIT_API_SECRET or LIVEKIT_URL here.
VITE_LIVEKIT_ENABLED=false
VITE_LIVEKIT_API_BASE_URL=
VITE_LIVEKIT_PUBLIC_URL=
# Local only: opt-in proxy to Functions emulator; false by default.
LIVEKIT_EMULATOR_PROXY=false

# Notifications: public Web Push key (Firebase Console > Cloud Messaging > Web Push certificates).
VITE_FIREBASE_VAPID_KEY=
# Server/Functions configuration. The access token belongs in Secret Manager, never VITE_*.
NOTIFICATION_SITE_ORIGIN=https://sharkset.web.app
WHATSAPP_BOOKING_CANCELLED_TEMPLATE=
WHATSAPP_TOURNAMENT_OPENED_TEMPLATE=
