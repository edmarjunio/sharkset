{
  "entities": {
    "Arena": {
      "title": "Arena",
      "description": "Unidade esportiva da rede SHARK SET com quadras e horários de funcionamento.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "city": { "type": "string", "maxLength": 80 },
        "state": { "type": "string", "maxLength": 10 },
        "distanceKm": { "type": "number" },
        "rating": { "type": "number" },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "city", "state", "ownerId"]
    },
    "AthletePublic": {
      "title": "AthletePublic",
      "description": "Perfil público e pontuação de ranking do atleta SHARK SET separado por País, Estado, Cidade e Arena.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "level": {
          "type": "string",
          "enum": ["iniciante", "serie_c", "serie_b", "serie_a", "profissional"]
        },
        "experienceCategory": {
          "type": "string",
          "enum": ["amador", "profissional"]
        },
        "points": { "type": "number" },
        "wins": { "type": "number" },
        "matchesPlayed": { "type": "number" },
        "titlesCount": { "type": "number" },
        "country": { "type": "string", "maxLength": 60 },
        "state": { "type": "string", "maxLength": 10 },
        "city": { "type": "string", "maxLength": 80 },
        "arenaId": { "type": "string", "maxLength": 64 },
        "arenaName": { "type": "string", "maxLength": 120 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "level", "points", "country", "state", "city", "arenaId", "ownerId"]
    },
    "BookingRecord": {
      "title": "BookingRecord",
      "description": "Reserva de horário de quadra com suporte a alerta de 15 minutos e lista de espera.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "maxLength": 64 },
        "courtId": { "type": "string", "maxLength": 64 },
        "courtName": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "sport": { "type": "string", "enum": ["futevolei", "beach_tennis", "volei_praia"] },
        "customerName": { "type": "string", "maxLength": 120 },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmed", "cancelled"] },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "tenantId", "courtId", "date", "startTime", "status", "ownerId"]
    },
    "SmartNotification": {
      "title": "SmartNotification",
      "description": "Notificação inteligente disparada por vaga em 2h, lista de espera, jogo a 10 pontos do fim ou lembrete de 15 min.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": {
          "type": "string",
          "enum": [
            "vacant_2h",
            "waitlist_freed",
            "match_10pts_left",
            "booking_15min",
            "match_starting",
            "match_modified",
            "tuition_due_today",
            "tuition_due_2days"
          ]
        },
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 400 },
        "recipientName": { "type": "string", "maxLength": 120 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "type", "title", "body", "ownerId"]
    },
    "MatchMvpVote": {
      "title": "MatchMvpVote",
      "description": "Voto de MVP (Craque da Partida) registrado ao final de um jogo do chaveamento SHARK SET.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "matchId": { "type": "string", "maxLength": 64 },
        "tournamentId": { "type": "string", "maxLength": 64 },
        "tournamentName": { "type": "string", "maxLength": 120 },
        "playerName": { "type": "string", "maxLength": 120 },
        "pairNames": { "type": "string", "maxLength": 160 },
        "voterName": { "type": "string", "maxLength": 120 },
        "votedAt": { "type": "string", "maxLength": 40 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "matchId", "tournamentId", "playerName", "pairNames", "voterName", "votedAt", "ownerId"]
    },
    "AcademyPost": {
      "title": "AcademyPost",
      "description": "Conteúdo didático e tático postado na Comunidade & Academia de Futevôlei SHARK SET.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 140 },
        "category": {
          "type": "string",
          "enum": ["marcacao_padrao", "posicionamento_quadra", "corrida_areia", "base_defesa", "ataque_shark", "comunidade"]
        },
        "mediaType": {
          "type": "string",
          "enum": ["video", "document", "image"]
        },
        "mediaUrl": { "type": "string", "maxLength": 500 },
        "summary": { "type": "string", "maxLength": 600 },
        "authorName": { "type": "string", "maxLength": 100 },
        "level": {
          "type": "string",
          "enum": ["iniciante", "intermediario", "avancado", "todos"]
        },
        "likesCount": { "type": "number" },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "title", "category", "mediaType", "summary", "authorName", "level", "likesCount", "ownerId"]
    }
  },
  "firestore": {
    "/arenas/{arenaId}": {
      "schema": { "$ref": "#/entities/Arena" },
      "description": "Unidades SHARK SET cadastradas"
    },
    "/athletes_public/{athleteId}": {
      "schema": { "$ref": "#/entities/AthletePublic" },
      "description": "Perfis públicos de atletas para o Ranking Geral, País, Estado, Cidade e Arena"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/BookingRecord" },
      "description": "Reservas de quadras de areia do usuário autenticado"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/SmartNotification" },
      "description": "Histórico de push notifications e alertas inteligentes do usuário"
    },
    "/match_mvp_votes/{voteId}": {
      "schema": { "$ref": "#/entities/MatchMvpVote" },
      "description": "Votos de MVP eleitos pelos atletas e espectadores ao final das partidas"
    },
    "/academy_posts/{postId}": {
      "schema": { "$ref": "#/entities/AcademyPost" },
      "description": "Aulas, vídeos, apostilas e análises táticas da Comunidade Futevôlei SHARK SET"
    }
  }
}
